#!/usr/bin/env bash
# Fake arecord: `-L` prints an arecord-style PCM listing that includes the fake ATVVoice node (atvvoice_mic),
# so the doctor's voxtype-device row can see an ALSA PCM of that name. Anything else is an error.
source "$(dirname "$0")/fake-log.sh"; fake_log "arecord $*"
[[ ${1:-} == -L ]] || exit 1
cat <<'LIST'
null
    Discard all samples (playback) or generate zero samples (capture)
default
    Default Audio Device
atvvoice_mic
    ATVVoice remote (atvvoice_mic)
sysdefault:CARD=PCH
    HDA Intel PCH, ALC285 Analog
LIST
