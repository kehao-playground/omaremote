#!/usr/bin/env bash
# Spec §6.2 item 4 and §7 `--doctor`: collect host facts as one JSON object for lib/Doctor.mjs, so the panel and the
# setup script can never disagree. Read-only; needs jq and awk (Omarchy ships both). Never sudo.
# Ruling 16 (Task 8 fix round 1): every external tool invocation is bounded by `timeout 2` so a wedged tool
# (keyd/hyprctl/voxtype/systemctl/busctl/pw-dump) degrades the fact it feeds to the same null/absent shape this
# script already uses when the tool is missing entirely, instead of hanging the script (and the CommandRunner
# job on the Service side) forever. The single-JSON-object guarantee holds either way.
set -u
TO=2
has() { command -v "$1" >/dev/null 2>&1; }
jbool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }                    # unbounded: local/instant checks only
jbool_bounded() { if timeout "$TO" "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }   # a timeout kill (124/137) reads as false, same as any other failure
jstr() { if [[ -n ${1:-} ]]; then jq -Rn --arg v "$1" '$v'; else echo null; fi; }
# Runs "$@" bounded by `timeout $TO`; prints its stdout and succeeds, or prints nothing and fails on a timeout
# kill — callers use the failure to degrade the fact to the same shape used when the tool itself is missing.
bounded() { local out; out=$(timeout "$TO" "$@" 2>/dev/null); local rc=$?; (( rc == 124 || rc == 137 )) && return 1; printf '%s' "$out"; }

tools=""
for t in keyd wtype playerctl wpctl pw-dump voxtype evtest jq node; do tools+="\"$t\":$(jbool has "$t"),"; done
tools="{${tools%,}}"

keyd_enabled=$(jbool_bounded systemctl is-enabled keyd)
keyd_active=$(jbool_bounded systemctl is-active keyd)
if has keyd && [[ -r /etc/keyd/omaremote.conf ]]; then keyd_check=$(jbool_bounded keyd check /etc/keyd/omaremote.conf); else keyd_check=null; fi
# The evdev grab itself is only visible to root; keyd's virtual keyboard existing while keyd is active is the observable proxy.
keyd_grab=$(jbool_bounded grep -q 'keyd virtual keyboard' /proc/bus/input/devices)

hypr_required=$(jbool_bounded grep -q 'require("hypr.omaremote")' "$HOME/.config/hypr/hyprland.lua")
if has hyprctl && raw=$(bounded hyprctl binds -j); then
  hypr_desc=$(jq -c '[.[] | (.description // "") | select(startswith("omaremote:"))]' <<<"$raw" 2>/dev/null)
fi
hypr_desc=${hypr_desc:-null}

if has voxtype; then
  if raw=$(bounded voxtype --version); then vox_version=$(jstr "$(awk '{print $2}' <<<"$raw")"); else vox_version=null; fi
  if raw=$(bounded voxtype status --format json); then vox_class=$(jq -c '.class // "stopped"' <<<"$raw" 2>/dev/null); vox_class=${vox_class:-null}; else vox_class=null; fi
  if raw=$(bounded voxtype config get output.mode --json); then vox_out=$(jq -c '.value' <<<"$raw" 2>/dev/null); vox_out=${vox_out:-null}; else vox_out=null; fi
  if raw=$(bounded voxtype config get audio.device --json); then vox_dev=$(jq -c '.value' <<<"$raw" 2>/dev/null); vox_dev=${vox_dev:-null}; else vox_dev=null; fi
else
  vox_version=null; vox_class=null; vox_out=null; vox_dev=null
fi

atv_active=$(jbool_bounded systemctl --user is-active atvvoice)
atv_ondemand=$(jbool_bounded bash -c 'systemctl --user show atvvoice --property=ExecStart --value 2>/dev/null | grep -q -- "--mic-on-demand"')
if raw=$(bounded busctl --user list --no-legend); then
  atv_names=$(awk '$1 ~ /^org\.atvvoice\./ { print $1 }' <<<"$raw" | jq -R . | jq -sc .)
else
  atv_names="[]"
fi
atv_first=$(jq -r '.[0] // empty' <<<"$atv_names")
atv_node=null
if [[ -n $atv_first ]] && raw=$(bounded busctl --user get-property "$atv_first" /org/atvvoice/Daemon org.atvvoice.Daemon NodeName); then
  atv_node=$(jstr "$(sed -n 's/^s "\(.*\)"$/\1/p' <<<"$raw")")
fi

if has pw-dump && raw=$(bounded pw-dump); then
  pw_sources=$(jq -c '[.[] | select(.type == "PipeWire:Interface:Node") | select((.info.props["media.class"] // "") == "Audio/Source") | .info.props["node.name"]]' <<<"$raw" 2>/dev/null)
fi
pw_sources=${pw_sources:-null}

cat <<JSON
{"tools":$tools,
 "keyd":{"enabled":$keyd_enabled,"active":$keyd_active,"checkOk":$keyd_check,"grabbed":$keyd_grab},
 "hypr":{"required":$hypr_required,"descriptions":$hypr_desc},
 "voxtype":{"version":$vox_version,"statusClass":$vox_class,"outputMode":$vox_out,"audioDevice":$vox_dev},
 "atvvoice":{"active":$atv_active,"micOnDemand":$atv_ondemand,"busNames":$atv_names,"nodeName":$atv_node},
 "pipewire":{"sources":$pw_sources}}
JSON
