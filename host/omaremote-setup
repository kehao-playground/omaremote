#!/usr/bin/env bash
# OmaRemote host setup. Idempotent; every subcommand is safe to re-run.
# Spec: docs/superpowers/specs/2026-10-02-omaremote-host-setup-design.md
set -euo pipefail

DEVICE_ID=${OMAREMOTE_DEVICE:-2717:32b8}
KEYD_CONF=/etc/keyd/omaremote.conf
ASSUME_YES=0

# "one" = a single hl.bind per key; "two" = press plus { release = true }.
# tests/bind-matrix.sh measured one bind 12/12 clean and two binds duplicating the release in every
# cell -- but that sweep runs inside a self-test lease, which suppresses KeyEngine (Service.qml:242)
# so no action is dispatched during a measured press. The release edge is actually lost when `wtype`
# runs mid-press, for EITHER bind count; see docs/hw-keymap-xiaomi-voice-remote.md. So the bind count
# is chosen on the remaining merits -- fewer lines, no duplicate releases -- and not because it fixes
# anything. Switching to two changes nothing about the wtype defect.
BIND_MODE=${OMAREMOTE_BIND_MODE:-one}
HYPR_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/hypr
# Without this xkb option, symbols/pc leaves <FK13>-<FK24> unmapped and inet(evdev) gives them
# XF86Tools / XF86Launch5-9 / XF86AudioMicMute / XF86Touchpad* -- only F19 and F24 keep their own
# names, so eleven of the thirteen binds below can never match and the remote does nothing at all.
XKB_OPTION=fkeys:basic_13-24
PLUGIN_ID=io.github.kehao-chen.omaremote
SHELL_CMD=${OMAREMOTE_SHELL:-omarchy-shell}
MIC_MODE=remote   # plan 4 §3: --mic remote|system; system skips the atvvoice step (external microphone hosts)
MIC_EXPLICIT=0    # 1 once --mic is given: only then does the bare `mic` subcommand take MIC_MODE as its default
# ATVVoice, pinned to the commit measured against the Xiaomi RC003 on 2026-10-12.
ATV_REPO=https://github.com/b0o/ATVVoice
ATV_REV=0e8f6413dc4bad7a04e3c6b648945439d7a22fac
# Built from the pinned rev plus a repo patch (the RC003 never sends AUDIO_SYNC, which upstream needs to reset its
# ADPCM decoder; the patch resets it at AUDIO_START). Located from $0, like tests/inject-key.py.
# Absolute: git -C <workdir> apply would otherwise resolve a relative path inside the work dir.
# SELF_DIR follows a symlinked invocation to the real script, so host/patches and tests/ are found.
SELF_DIR=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
ATV_PATCH=${OMAREMOTE_ATV_PATCH:-$SELF_DIR/../host/patches/atvvoice-reset-decoder.patch}
# A failed cd keeps the value as given, so the later die names the path the user passed.
if [[ $ATV_PATCH != /* ]]; then
  _d=$(cd "$(dirname "$ATV_PATCH")" 2>/dev/null && pwd) && ATV_PATCH=$_d/$(basename "$ATV_PATCH")
  unset _d
fi
ATV_BIN=${OMAREMOTE_ATV_BIN:-$HOME/.cargo/bin/atvvoice}
# One line, `rev=<ATV_REV> patch=<sha256 of the patch>`; written only after a successful install.
ATV_STAMP=${OMAREMOTE_ATV_STAMP:-${XDG_STATE_HOME:-$HOME/.local/state}/omaremote/atvvoice.build}
ATV_UUID=ab5e0001-5a21-4f05-bc7d-af01f617b664
ATV_UNIT=${OMAREMOTE_ATV_UNIT:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/atvvoice.service}
# One name for the unit's --name, the PipeWire node ATVVoice then creates, and the ALSA PCM we define for it.
# Voxtype 1.1.0 captures only through ALSA (cpal), which lists PCMs, not PipeWire nodes -- so the PCM must be
# named exactly like the node, which also keeps MicApply's `audio.device = <node>` and the doctor unchanged.
ATV_NAME=xiaomi
ATV_NODE=atvvoice-$ATV_NAME
ALSA_RC=${OMAREMOTE_ALSA_RC:-${XDG_CONFIG_HOME:-$HOME/.config}/alsa/asoundrc}
ALSA_BEGIN='# BEGIN omaremote atvvoice (managed by omaremote-setup; do not edit)'
ALSA_END='# END omaremote atvvoice'
# Mic source picker spec §4.1: the second managed block, the PCM Voxtype opens for a picked source.
MIC_BEGIN='# BEGIN omaremote mic (managed by omaremote-setup; do not edit)'
MIC_END='# END omaremote mic'
MIC_PCM=omaremote-mic
# Plan ruling 3: lib/AlsaMic.mjs NODE_RE is the same pattern. The first character is never `-`.
NODE_RE='^[A-Za-z0-9_.:][A-Za-z0-9_.:-]*$'
ALSA_LOCK_WAIT=${OMAREMOTE_ALSA_LOCK_WAIT:-5}
ALSA_CONTENT=""
ALSA_CHANGED=0

# Learned on 2026-10-02 from the real remote; see docs/hw-keymap-xiaomi-voice-remote.md.
# TODO(plan4): replace this table with the interactive learning step of main spec §7 step 2.
# logical -> "<source key as the remote emits it>:<neutral key>"
declare -A LEARNED_KEYS=(
  [up]="up:f13"            [down]="down:f14"       [left]="left:f15"
  [right]="right:f16"      [ok]="enter:f17"        [back]="back:f18"
  [home]="home:f19"        [menu]="compose:f20"    [app]="grave:f21"
  [volup]="volumeup:f22"   [voldown]="volumedown:f23"
  [power]="power:f24"      [mic]="f5:xfer"
)
# Deterministic order, so a regenerated conf is byte-identical and stage_file sees no change.
KEY_ORDER=(up down left right ok back home menu app volup voldown power mic)

# One work dir per run, created eagerly and removed by one EXIT trap. Two earlier shapes of
# this were wrong, both worth recording because the failures were silent:
#   * `trap 'rm -f "$tmp"' RETURN` inside a function is not scoped to that function. It stays
#     installed and fires again when the next function returns, where the local it names is
#     already gone -- under `set -u` that made a wholly successful run exit non-zero. It also
#     never fires on `die`, so it leaked on exactly the paths that mattered.
#   * A `mktmp` helper that appended to a registry and printed the path could not work either:
#     callers use `t=$(mktmp)`, a command substitution, so the append mutated a subshell's copy
#     of the registry and the parent cleaned up nothing.
# A directory created before any subshell exists avoids both: nothing has to be registered.
WORKDIR=$(mktemp -d -t omaremote-setup.XXXXXXXX)
cleanup_tmp() { [[ -n ${WORKDIR:-} && -d ${WORKDIR:-} ]] && rm -rf -- "$WORKDIR"; return 0; }
trap cleanup_tmp EXIT

say()  { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }
die()  { printf 'omaremote-setup: %s\n' "$*" >&2; exit 1; }
warn() { printf 'omaremote-setup: warning: %s\n' "$*" >&2; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

# PIDs of any keyd daemon NOT owned by keyd.service. keyd allows one instance only, so a
# leftover foreground run makes `systemctl start keyd` fail on the socket. Excludes
# `keyd monitor`, which is a client and does not hold the socket.
stray_keyd() {
  local main pid out=""
  main=$(systemctl show -p MainPID --value keyd 2>/dev/null || echo 0)
  for pid in $(pgrep -x keyd 2>/dev/null || true); do
    [[ $pid == "$main" ]] && continue
    out+="$pid "
  done
  printf '%s' "${out% }"
}

# Stage, validate, compare, replace only on a difference, keep a .bak. Never writes blind.
stage_file() {   # stage_file <dest> <staged-tmp> [sudo]
  local dest=$1 tmp=$2 use_sudo=${3:-}
  [[ -s $tmp ]] || die "refusing to install an empty file to $dest"
  if [[ -f $dest ]] && $use_sudo cmp -s "$tmp" "$dest" 2>/dev/null; then
    say "unchanged: $dest"; return 0
  fi
  if [[ -f $dest ]]; then
    $use_sudo cp -a "$dest" "$dest.bak" && say "kept previous version at $dest.bak"
  fi
  $use_sudo install -D -m 0644 "$tmp" "$dest"
  say "wrote: $dest"
}

# The keyd action for one learned key. The mic key is the exception (hardware acceptance 2026-10-14): mapped plainly,
# the remote holds it for the whole hold and keyd autorepeats it, and `macro()` repeats every 50 ms; either lands key
# events inside Typeless's hotkey tap, which Typeless then ignores. `macro2(0, 0, …)` sends one pulse at press time.
# Only keys.mic.trigger "ptt" uses the real down/up, so only it keeps the held key.
keyd_action() {   # keyd_action <logical> <neutral>
  if [[ $1 == mic ]] && [[ $(jq -r '.keys.mic.trigger // "toggle"' "$OMA_CONFIG" 2>/dev/null) != ptt ]]; then
    printf 'macro2(0, 0, %s)' "$2"
  else
    printf '%s' "$2"
  fi
}

gen_keyd_conf() {   # gen_keyd_conf > file
  printf '# Generated by omaremote-setup for %s. Do not edit by hand.\n' "$DEVICE_ID"
  printf '# The [ids] explicit-list form matches ONLY this device, so the keyboard is never grabbed.\n\n'
  printf '[ids]\n%s\n\n[main]\n' "$DEVICE_ID"
  local k src neutral
  for k in "${KEY_ORDER[@]}"; do
    IFS=: read -r src neutral <<< "${LEARNED_KEYS[$k]}"
    printf '%-12s = %s\n' "$src" "$(keyd_action "$k" "$neutral")"
  done
}

cmd_deps() {
  step "checking host tools"
  local t
  for t in jq pw-dump wpctl voxtype hyprctl; do
    if command -v "$t" >/dev/null 2>&1; then say "  ok      $t"; else say "  MISSING $t"; fi
  done
  if command -v keyd >/dev/null 2>&1; then
    say "  ok      keyd ($(keyd --version 2>&1 | head -1))"
  else
    say "  MISSING keyd"
    say ""
    say "Install it yourself, then re-run this subcommand:"
    say "    sudo pacman -S --needed keyd"
    say "Note: install only. Do NOT enable the service yet -- 'omaremote-setup keyd' validates the"
    say "config in the foreground first, because a bad keyd config can make a machine unusable."
    return 1
  fi
}

# Print just the generated conf, unindented, for machine checks. No prompts, no staging,
# nothing written. 'keyd' prints the same bytes indented for human reading, so a checker
# must use this rather than scraping that output.
cmd_genconf() { gen_keyd_conf; }

cmd_keyd() {
  need keyd
  step "staging $KEYD_CONF for $DEVICE_ID"
  local tmp=$WORKDIR/omaremote.conf
  gen_keyd_conf > "$tmp"
  sed 's/^/    /' "$tmp"

  step "validating the staged config with keyd check"
  # Validate before anything is written under /etc. keyd check wants a .conf in a directory it scans.
  local checkdir=$WORKDIR/check; mkdir -p "$checkdir"; cp "$tmp" "$checkdir/omaremote.conf"
  keyd check "$checkdir/omaremote.conf" || die "keyd check rejected the generated config; nothing was written"
  say "keyd check: ok"

  step "confirm the device id from keyd's own point of view"
  say "The man page names 'keyd monitor' as the source of device ids, so /proc/bus/input/devices is"
  say "corroboration, not authority. Run this and press ONE button on the remote:"
  say ""
  say "    sudo keyd monitor -t"
  say ""
  say "Expect a line whose device id is $DEVICE_ID. If it differs, re-run with"
  say "OMAREMOTE_DEVICE=<vendor:product> and nothing will be written until it matches."
  if (( ! ASSUME_YES )); then
    read -r -p "Did keyd monitor report $DEVICE_ID? [y/N] " a
    [[ ${a,,} == y ]] || die "device id not confirmed; $KEYD_CONF was not written"
  fi

  stage_file "$KEYD_CONF" "$tmp" sudo

  step "validate in the FOREGROUND before enabling the service"
  say "keyd.service is exactly 'ExecStart=/usr/bin/keyd', so a foreground run is equivalent to the"
  say "unit -- but Ctrl-C ends it, and closing the terminal ends it."
  say ""
  say "Rescue paths, before you start it:"
  say "  * backspace+escape+enter terminates keyd (documented in its README)"
  say "  * this config's [ids] lists only $DEVICE_ID, so your keyboard is never grabbed"
  say "  * Ctrl+Alt+F2 gives a second TTY where 'sudo systemctl stop keyd' works"
  say "  * removing $KEYD_CONF and running 'sudo keyd reload' reverts"
  say ""
  say "    Terminal A:  sudo /usr/bin/keyd"
  say "    Terminal B:  sudo keyd monitor -t      # press remote buttons; expect f13..f24 / xfer"
  say ""
  say "Confirm the remote now emits the neutral keys AND that your keyboard is unaffected."
  if (( ! ASSUME_YES )); then
    read -r -p "Foreground run clean, remote emits neutral keys, keyboard unaffected? [y/N] " a
    [[ ${a,,} == y ]] || die "foreground validation not confirmed; the service was NOT enabled"
  fi

  step "enabling the service"
  # keyd binds a single socket at /var/run/keyd.socket, so a foreground instance and the unit
  # cannot coexist: starting the service while the validation run is still alive fails with
  # "failed to create /var/run/keyd.socket (another instance already running?)" and leaves the
  # unit in `enabled` + `failed`, which reads like a broken config rather than a stray process.
  local stray; stray=$(stray_keyd)
  if [[ -n $stray ]]; then
    say "A keyd instance is running outside the service (pid(s): $stray)."
    say "Stop it first -- Ctrl-C the foreground run, and quit any 'keyd monitor' -- then:"
    say "    sudo systemctl enable --now keyd"
    say "Starting the unit now would fail on the socket, not on the config."
    return 1
  fi
  if systemctl is-active --quiet keyd; then
    # keyd is ALREADY running, so `systemctl enable --now keyd` is a no-op and the config we just
    # wrote would never load. On a re-run that is silent and total: keyd keeps serving the previous
    # mapping, every check that reads the FILE agrees with the new one, and only an injection
    # through keyd disagrees. Measured 2026-10-08: `f5 = prog1` -> `f5 = xfer` left keyd emitting
    # the old KEY_F21 for 50 minutes, so the mic key still fired `app` and the transport sweep
    # reported `app(down=2,up=2)` with `mic` missing -- both source keys landing on one code.
    step "reloading keyd so the new config takes effect"
    if sudo keyd reload; then
      say "keyd reloaded; the config above is now live"
    else
      die "keyd reload failed. The OLD mapping is still live. Check 'sudo keyd check' and the journal."
    fi
    say "keyd.service: active"
  else
    say "Run:  sudo systemctl enable --now keyd"
    say "Then re-run 'omaremote-setup keyd' to confirm it is active."
    say "keyd.service: not active yet"
  fi
}

# ---- Hyprland binds (Task 7) --------------------------------------------------------------
# The keysym for each neutral key. This table is duplicated from lib/Defaults.mjs NEUTRAL_KEYS
# because bash cannot import an ES module; tests/setup-helpers.sh asserts the two agree, which is
# the only thing stopping them drifting apart.
neutral_keysym() {   # neutral_keysym <logical> -> F13..F24 / XF86Xfer
  local neutral; IFS=: read -r _ neutral <<< "${LEARNED_KEYS[$1]}"
  # The 13th neutral key is NOT prog1. keyd's key-name table is not Linux's: keyd emits KEY_F21 for
  # the name `prog1` and KEY_F22 for `prog2` -- they alias f21..f24. `mic = prog1` therefore emitted
  # `app`'s exact code, so pressing mic fired omaremote:app and omaremote:mic never fired. `keyd
  # check` passes on that config and says nothing. Measured on the host 2026-10-08 by reading keyd's
  # own virtual keyboard; keyd monitor prints keyd's NAMES, which hid it.
  #
  # `xfer` was measured emitting its Linux code 147 = <I155> -> XF86Xfer: outside F13-F24, and with
  # no application meaning that could act if it ever escaped a bind.
  if [[ $neutral == xfer ]]; then printf 'XF86Xfer'; else printf '%s' "${neutral^^}"; fi
}

gen_lua() {
  printf -- '-- Generated by omaremote-setup. Do not edit by hand; re-run "omaremote-setup binds".\n'
  printf -- '-- Bind count per key (%s) was settled by measurement, not assumption: tests/bind-matrix.sh.\n' "$BIND_MODE"
  printf -- '-- Modifier combos are never generated FOR REMOTE KEYS: the modmask stops matching once the\n'
  printf -- '-- modifier is released first, which loses the release edge. The keyboard escape hatch at the\n'
  printf -- '-- bottom does use one, deliberately -- it dispatches on press and needs no release edge.\n'
  printf -- '-- Requires the xkb option %s; see docs/hw-keymap-xiaomi-voice-remote.md.\n\n' "$XKB_OPTION"
  local k sym
  for k in "${KEY_ORDER[@]}"; do
    sym=$(neutral_keysym "$k")
    printf 'hl.bind("%s", hl.dsp.global("omaremote:%s"), { description = "omaremote:%s" })\n' "$sym" "$k" "$k"
    [[ $BIND_MODE == two ]] && printf 'hl.bind("%s", hl.dsp.global("omaremote:%s"), { description = "omaremote:%s", release = true })\n' "$sym" "$k" "$k"
  done
  printf -- '\n-- Keyboard escape hatch, independent of the remote (main spec 4.3).\n'
  printf 'o.bind("SUPER + CTRL + ALT + R", "OmaRemote reset", "omarchy-shell omaremote reset")\n'
}

live_kb_options() { hyprctl getoption input:kb_options 2>/dev/null | sed -n 's/^str: //p'; }

# Make F13-F24 real. Idempotent, and decided from the LIVE value rather than from the file, because
# the file is only the request and hyprctl is the result.
ensure_xkb() {
  step "ensuring the xkb option $XKB_OPTION is active"
  local live; live=$(live_kb_options)
  if [[ $live == *"$XKB_OPTION"* ]]; then
    say "already active: $live"
    return 0
  fi
  say "current kb_options: ${live:-<unset>}"
  # kb_options REPLACES rather than appends, so whatever Omarchy set has to be carried over or the
  # user loses it (compose:caps and shift:both_capslock_cancel on a default install). Build the new
  # value from the live one instead of hard-coding Omarchy's defaults.
  local want=${live:+$live,}$XKB_OPTION
  if grep -q "$XKB_OPTION" "$HYPR_DIR/input.lua" 2>/dev/null; then
    die "input.lua already requests $XKB_OPTION but it is not active -- run 'hyprctl reload' and check 'hyprctl configerrors'"
  fi
  cp -a "$HYPR_DIR/input.lua" "$HYPR_DIR/input.lua.bak"
  {
    printf -- '\n-- Added by omaremote-setup. REQUIRED for the remote to work.\n'
    printf -- '-- keyd remaps the remote to F13-F24, but /usr/share/X11/xkb/symbols/pc never maps\n'
    printf -- '-- <FK13>-<FK24>; inet(evdev) hands them out as XF86Tools / XF86Launch5-9 /\n'
    printf -- '-- XF86AudioMicMute / XF86Touchpad*, with only F19 and F24 keeping their own names.\n'
    printf -- '-- Without %s, eleven of the thirteen omaremote binds can never match.\n' "$XKB_OPTION"
    printf -- '-- The leading options are what was live when this was generated; kb_options REPLACES\n'
    printf -- '-- rather than appends, so dropping them would cost you those settings.\n'
    printf -- '-- To remove OmaRemote.s keyboard change entirely, delete this whole hl.config block.\n'
    printf 'hl.config({\n  input = {\n    kb_options = "%s",\n  },\n})\n' "$want"
  } >> "$HYPR_DIR/input.lua"
  say "appended kb_options = \"$want\" (previous version at input.lua.bak)"
  hyprctl reload >/dev/null
  check_configerrors
  live=$(live_kb_options)
  [[ $live == *"$XKB_OPTION"* ]] || die "kb_options is still '$live' after a reload; $XKB_OPTION did not take effect"
  say "now active: $live"
}

# hyprctl reload answers "ok" even when the Lua raised, keeping the PREVIOUS config loaded, and
# nothing reaches the Hyprland log. Only configerrors reports it. Checked after every reload.
check_configerrors() {
  local e; e=$(hyprctl configerrors 2>&1 | grep -v '^$' || true)
  [[ -z $e ]] || { printf '%s\n' "$e" | sed 's/^/    /' >&2; die "hyprctl configerrors is not clean (see above)"; }
}

verify_binds() {
  local per=1; [[ $BIND_MODE == two ]] && per=2
  local want=$(( ${#KEY_ORDER[@]} * per ))
  local got; got=$(hyprctl binds -j | jq '[.[].description | select(startswith("omaremote:"))] | length')
  if [[ $got == "$want" ]]; then say "binds loaded: $got (expected $want)"; return 0; fi
  # Review focus 4: zero and too-many need opposite fixes, so never report them as one "mismatch".
  if [[ $got == 0 ]]; then
    if grep -q 'require("hypr.omaremote")' "$HYPR_DIR/hyprland.lua"; then
      die "no omaremote binds loaded although the require line is present -- check 'hyprctl configerrors' and $HYPR_DIR/omaremote.lua for a Lua error"
    fi
    die "no omaremote binds loaded because hyprland.lua has no require(\"hypr.omaremote\") line"
  fi
  if (( got > want )); then
    say "duplicate or leftover omaremote binds -- descriptions seen:"
    hyprctl binds -j | jq -r '.[].description | select(startswith("omaremote:"))' | sort | uniq -c | sed 's/^/    /'
    die "expected $want, found $got; remove any stale generated or hand-written omaremote binds and re-run"
  fi
  die "expected $want omaremote binds, found only $got; some keys did not bind"
}

cmd_binds() {
  need hyprctl; need jq
  [[ $BIND_MODE == one || $BIND_MODE == two ]] || die "BIND_MODE must be 'one' or 'two' (settled by tests/bind-matrix.sh); got '$BIND_MODE'"
  hyprctl version >/dev/null 2>&1 || die "hyprctl cannot reach Hyprland (HYPRLAND_INSTANCE_SIGNATURE unset?); run this from a terminal inside your Hyprland session"
  ensure_xkb

  step "generating $HYPR_DIR/omaremote.lua ($BIND_MODE-bind)"
  local tmp=$WORKDIR/omaremote.lua
  gen_lua > "$tmp"
  stage_file "$HYPR_DIR/omaremote.lua" "$tmp"

  step "ensuring hyprland.lua requires it"
  if grep -q 'require("hypr.omaremote")' "$HYPR_DIR/hyprland.lua"; then
    say "require line already present"
  else
    cp -a "$HYPR_DIR/hyprland.lua" "$HYPR_DIR/hyprland.lua.bak"
    printf '%s\n' 'require("hypr.omaremote")' >> "$HYPR_DIR/hyprland.lua"
    say "appended require(\"hypr.omaremote\") (previous version at hyprland.lua.bak)"
  fi

  step "reloading and verifying"
  hyprctl reload >/dev/null
  check_configerrors
  verify_binds
}

# ---- plugin, mic mode, verification (Task 8) ----------------------------------------------
# Typeless spec §4.3: every IPC call is bounded, so a wedged shell cannot hang setup.
IPC_TIMEOUT=${OMAREMOTE_IPC_TIMEOUT:-3}
ipc() { timeout "$IPC_TIMEOUT" $SHELL_CMD omaremote "$@"; }

cmd_plugin() {
  need omarchy; need jq
  step "ensuring the plugin is installed and enabled"
  if omarchy plugin list 2>/dev/null | grep -q "$PLUGIN_ID"; then
    say "plugin present: $PLUGIN_ID"
  else
    say "Install it from this checkout, then re-run:"
    say "    omarchy plugin add . --enable"
    return 1
  fi
  $SHELL_CMD shell rescanPlugins >/dev/null 2>&1 || true
  step "waiting for the service to answer (at most 15 s)"
  local i=0
  while (( i < 150 )); do
    [[ $(ipc selftestPing 2>/dev/null) == ok ]] && { say "selftestPing: ok"; return 0; }
    sleep 0.1; i=$((i + 1))
  done
  die "the service never answered selftestPing. A changed keepLoaded manifest needs a full restart: omarchy-restart-shell"
}

# The plugin refuses remote mode until it knows the remote's PipeWire node, and it learns that only after
# ATVVoice has connected to the remote and registered on D-Bus. `systemctl enable --now` returns at fork,
# and a sleeping remote may not connect until a button wakes it -- so wait for .remote.node, bounded.
wait_remote_node() {
  local wait_ms=${OMAREMOTE_NODE_WAIT_MS:-30000} poll_ms=${OMAREMOTE_NODE_POLL_MS:-500}
  local tries=$(( (wait_ms + poll_ms - 1) / poll_ms )) i=0 node="" hinted=0
  while (( i < tries )); do
    node=$(ipc status 2>/dev/null | jq -r '.remote.node // empty' 2>/dev/null) || node=""
    [[ -n $node ]] && { say "remote audio node: $node"; return 0; }
    (( hinted )) || { say "Waiting for the remote's audio node -- press any button on the remote to wake it"; hinted=1; }
    sleep "$(printf '%d.%03d' $((poll_ms / 1000)) $((poll_ms % 1000)))"; i=$((i + 1))
  done
  die "the remote's audio node never appeared within $((wait_ms / 1000)) s (is ATVVoice running and the remote awake?). Wake the remote, then retry: omaremote-setup mic remote"
}

cmd_mic() {   # cmd_mic <remote|system>
  need jq
  local mode=${1:-system}
  [[ $mode == remote || $mode == system ]] || die "mic mode must be 'remote' or 'system'; got '$mode'"
  [[ $mode == remote ]] && wait_remote_node
  step "applying mic mode: $mode"
  say "This restarts voxtype once. Do not use F9 until it finishes."
  local r id; r=$(ipc mic "$mode"); id=$(jq -r '.operationId // empty' <<< "$r")
  [[ -n $id ]] || die "mic apply was not accepted: $r"
  say "operation $id queued; polling"
  local i=0 state=""
  while (( i < 150 )); do          # 150 s client budget per main spec §7 step 5
    state=$(ipc micStatus "$id" | jq -r '.state // "?"')
    case $state in
      succeeded) say "mic mode applied: $mode"; return 0 ;;
      failed|rollingBack) die "mic apply ended $state: $(ipc micStatus "$id")" ;;
    esac
    sleep 1; i=$((i + 1))
  done
  die "mic apply did not reach a terminal state within 150 s (last: $state); resolve before retrying"
}

cmd_verify() {
  need jq
  step "verifying the loaded binds"
  hyprctl version >/dev/null 2>&1 || die "hyprctl cannot reach Hyprland; run this from a terminal inside your Hyprland session"
  verify_binds

  step "verifying the transport"
  # Gated on sudo being USABLE, not on being root: this must stay a user-run script so its
  # omarchy-shell IPC reaches the user's session and $HOME is theirs.
  if ! sudo -n true 2>/dev/null; then
    say "SKIPPED: the transport sweep needs sudo for the injector (/dev/uinput)."
    say "Run 'sudo -v' to cache credentials, then re-run this subcommand. NOT reporting a pass."
    # Exit 2, not 0. Printing "NOT reporting a pass" and then exiting 0 tells a human one thing and
    # every caller the opposite, and the caller is what CI and `cmd_all` read. 2 means "did not
    # verify", distinct from 1, which means "verified and failed".
    return 2
  fi
  local inject; inject=$SELF_DIR/../tests/inject-key.py
  [[ -x $inject ]] || die "injector not found at $inject"

  # A refused arm names its blocker. backendStale is the common one and it is self-clearing:
  # nothing refreshes the 500 ms freshness window on its own, so any arm taken a moment after the
  # last poll is stale. Poll and WAIT for freshness rather than sleeping a guessed interval.
  #
  # `ipc voice poll -` takes two arguments: the IpcHandler function is voice(verb, arg) with fixed
  # arity, and the one-argument form answers "Too few arguments provided (2 required but 1 were
  # provided.)" -- so a retry written as `ipc voice poll` never polls and the next arm is just as
  # stale. That is exactly how this failed on first run.
  local r id tries=0
  while (( tries < 10 )); do
    r=$(ipc selftestArmFor 60000)
    id=$(jq -r '.id // empty' <<< "$r")
    [[ -n $id ]] && break
    case $(jq -r '.detail // "?"' <<< "$r") in
      heldKeys:*) die "cannot arm a lease while keys are held: $r (press nothing, or run 'omarchy-shell omaremote reset')" ;;
    esac
    ipc voice poll - >/dev/null 2>&1 || true
    local w=0
    while (( w < 20 )); do
      [[ $(ipc status | jq -r '.voice.backendFresh') == true ]] && break
      sleep 0.1; w=$((w + 1))
    done
    tries=$((tries + 1))
  done
  [[ -n $id ]] || die "could not arm a self-test lease after $tries tries: $r"

  # All 13 keys in ONE injected sequence rather than 13 create/destroy cycles: fewer device-add
  # events for the compositor to process, and closer to how a real keyboard behaves.
  #
  # Injecting `power` is safe here ONLY because a lease suppresses actions (Service.qml:242) --
  # outside a lease its tap blanks the screen, which is why tests/bind-matrix.sh excludes it. The
  # same suppression is what makes a lease unable to observe anything about actions, so this sweep
  # proves the TRANSPORT and nothing about what the keys do. Step 6's real-remote pass covers that.
  #
  # The sweep injects the remote's SOURCE keys while claiming the remote's vendor:product, so keyd
  # grabs the virtual device and its own remapping is under test too. Injecting the neutral keys
  # instead (the obvious shape, and what this did until 2026-10-08) bypasses keyd entirely: the
  # `[ids] <vendor>:<product>` list does not match a default-id uinput device, so those keysyms go
  # straight to the compositor. That gap hid a dead mic button through a passing sweep -- keyd
  # aliases the name `prog1` to KEY_F21, so `f5 = prog1` emitted `app`'s code and omaremote:mic
  # could never fire, while an injected `prog1` (Linux code 148) reached the bind and looked fine.
  #
  # A side benefit: because keyd grabs the device, the source keys cannot leak to the desktop.
  local k src seq=""
  for k in "${KEY_ORDER[@]}"; do
    IFS=: read -r src _ <<< "${LEARNED_KEYS[$k]}"
    seq+="${seq:+,}$src:120"
  done
  local vid pid
  IFS=: read -r vid pid <<< "$DEVICE_ID"
  sudo "$inject" --seq "$seq" --gap-ms 250 --vendor "$vid" --product "$pid" >/dev/null
  sleep 0.5

  local rep; rep=$(ipc selftestReport "$id")
  # NOT `.ok`: SelfTest.compute() counts down>1 or up>1 as an "extra", so a duplicate release --
  # which tests/bind-matrix.sh deliberately accepts, and which KeyEngine is verified to tolerate --
  # would fail here. The same transport would then qualify in Task 6 and fail in Task 8. Apply the
  # matrix's contract instead: every supported key down>=1 and up>=1, nothing held, no key seen that
  # was not injected. `.missing` is already exactly "supported keys with down<1 or up<1".
  local missing unexpected dupes held
  missing=$(jq -r '.missing | join(",")' <<< "$rep")
  unexpected=$(jq -r --argjson keys "$(printf '%s\n' "${KEY_ORDER[@]}" | jq -R . | jq -s .)" \
                  '[.counts.shortcut | keys[] | select(. as $k | $keys | index($k) | not)] | join(",")' <<< "$rep")
  dupes=$(jq -r '[.counts.shortcut | to_entries[] | select(.value.down > 1 or .value.up > 1)
                 | "\(.key)(down=\(.value.down),up=\(.value.up))"] | join(" ")' <<< "$rep")
  held=$(jq -r '.held | join(",")' <<< "$rep")
  [[ -n $dupes ]] && say "  duplicate edges (tolerated by KeyEngine, reported not fatal): $dupes"
  if [[ -z $missing && -z $unexpected && -z $held ]]; then
    say "transport: every supported key delivered at least one press and one release"
    return 0
  fi
  say "transport FAILED:"
  [[ -n $missing    ]] && say "  keys missing an edge: $missing"
  [[ -n $unexpected ]] && say "  keys seen that were never injected: $unexpected"
  [[ -n $held       ]] && say "  keys still held at the end: $held"
  return 1
}

atv_candidates() {   # paired devices exposing the ATV voice service, one address per line
  local a
  for a in $(bluetoothctl devices 2>/dev/null | awk '$1 == "Device" { print $2 }'); do
    bluetoothctl info "$a" 2>/dev/null | grep -qi -- "$ATV_UUID" && printf '%s\n' "$a"
  done
  return 0
}

atv_stamp_line() { printf 'rev=%s patch=%s\n' "$ATV_REV" "$(sha256sum "$ATV_PATCH" | cut -d' ' -f1)"; }

# Fetch the pinned rev, apply the repo patch, install the result. Any failure dies before the caller writes anything.
atv_build() {
  local src=$WORKDIR/atvvoice-src
  mkdir -p "$src"
  git -C "$src" init -q || die "git init failed; nothing was changed"
  git -C "$src" fetch --depth 1 "$ATV_REPO" "$ATV_REV" || die "git fetch of ATVVoice $ATV_REV failed; nothing was changed"
  git -C "$src" checkout -q FETCH_HEAD || die "git checkout failed; nothing was changed"
  git -C "$src" apply "$ATV_PATCH" || die "the ATVVoice patch no longer applies to $ATV_REV; nothing was changed"
  cargo install --locked --path "$src" --force || die "cargo install failed; nothing was changed"
}

gen_atv_unit() {   # gen_atv_unit <addr> > file
  cat <<EOF
# Generated by omaremote-setup. Do not edit by hand; re-run \`omaremote-setup atvvoice\`.
# No --mic-on-demand: the Xiaomi RC003 sends no audio for a host MIC_OPEN, only while its button is
# held (plan 4 spec §2). --name avoids an invalid D-Bus name derived from the remote's Chinese name.
[Unit]
Description=ATVVoice: Bluetooth voice remote as a PipeWire microphone
After=pipewire.service bluetooth.target

[Service]
ExecStart=%h/.cargo/bin/atvvoice --device $1 --name $ATV_NAME
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF
}

gen_alsa_block() {
  cat <<EOF
$ALSA_BEGIN
pcm.$ATV_NODE {
  type pipewire
  capture_node "$ATV_NODE"
  hint { show on description "ATVVoice remote ($ATV_NODE)" }
}
$ALSA_END
EOF
}

gen_mic_block() {   # gen_mic_block <node>: the canonical mic block, markers included, no final newline
  printf '%s\npcm.%s {\n  type pipewire\n  capture_node "%s"\n  hint { show on description "omaremote picked microphone" }\n}\n%s' \
    "$MIC_BEGIN" "$MIC_PCM" "$1" "$MIC_END"
}

# Spec §4.2 single-snapshot parsing: one open of $ALSA_RC, its whole content into ALSA_CONTENT. Every parse below works
# on this copy, never on the pathname again, so a writer's rename can never mix two versions into one reading.
# A missing file reads as empty. The trailing `x` keeps the file's final newlines, which $(...) would strip.
alsa_rc_read() {
  ALSA_CONTENT=""
  [[ -e $ALSA_RC ]] || return 0
  local c; c=$(cat -- "$ALSA_RC" && printf x) || return 1
  ALSA_CONTENT=${c%x}
}

# alsa_block_state <content> <begin> <end> <strict>: absent | present | present <node> | bad.
# bad = unbalanced, misordered or repeated markers; with strict=1 (the mic block) also anything but exactly one
# `capture_node "<node>"` line between them whose value matches NODE_RE.
alsa_block_state() {
  printf '%s' "$1" | awk -v beg="$2" -v end="$3" -v strict="$4" -v re="$NODE_RE" '
    $0 == beg { nb++; if (ne > 0 || inb) bad = 1; inb = 1; next }
    $0 == end { ne++; if (!inb) bad = 1; inb = 0; next }
    inb && $0 ~ /^[ \t]*capture_node[ \t]/ {
      nc++; v = $0
      ok = sub(/^[ \t]*capture_node[ \t]+"/, "", v) && sub(/"[ \t]*$/, "", v)
      if (!ok || v !~ re) badv = 1
    }
    END {
      if (nb == 0 && ne == 0) { print "absent"; exit }
      if (bad || nb != 1 || ne != 1 || inb) { print "bad"; exit }
      if (strict == "1") { if (nc != 1 || badv) print "bad"; else print "present " v; exit }
      print "present"
    }'
}

# alsa_rc_put <content> <begin> <end> <block>: the new content (spec §4.1 layout). The caller has ruled out `bad`.
# Absent + block: append, after one newline only if the content does not already end in one (the ONLY byte this
# function ever adds outside a block). Present: cut the content at the BEGIN and END lines and keep both outside parts
# byte for byte (a last line without a newline included); put the block between them, or nothing when it is empty.
# No awk here: awk's print would re-terminate every outside line it copies.
alsa_rc_put() {
  local c=$1 b=$2 e=$3 blk=$4 pre rest post endnl=1
  local st; st=$(alsa_block_state "$c" "$b" "$e" 0)
  case $st in absent|present|"present "*) ;; *) return 1 ;; esac      # bad, or no answer at all: refuse
  if [[ $st == absent ]]; then
    printf '%s' "$c"
    if [[ -z $blk ]]; then return 0; fi
    if [[ -n $c && ${c: -1} != $'\n' ]]; then printf '\n'; fi
    printf '%s\n' "$blk"
    return 0
  fi
  # present: exactly one BEGIN line, before exactly one END line. BEGIN is never the last line, so a newline follows it.
  if [[ $c == "$b"$'\n'* ]]; then pre=""; rest=${c#"$b"$'\n'}
  else pre=${c%%$'\n'"$b"$'\n'*}$'\n'; rest=${c#*$'\n'"$b"$'\n'}; fi
  if [[ $rest == "$e" ]]; then post=""; endnl=0                        # block is the whole rest, END unterminated
  elif [[ $rest == "$e"$'\n'* ]]; then post=${rest#"$e"$'\n'}
  elif [[ $rest == *$'\n'"$e"$'\n'* ]]; then post=${rest#*$'\n'"$e"$'\n'}
  else post=""; endnl=0; fi                                             # END is the last line, unterminated
  printf '%s' "$pre"
  if [[ -n $blk ]]; then printf '%s' "$blk"; if (( endnl )); then printf '\n'; fi; fi
  printf '%s' "$post"
}

# alsa_rc_write <content>: atomic replace, a temp file in the same directory then a rename. Readers never see a part.
alsa_rc_write() {
  # Write through a symlinked asoundrc (dotfile managers): resolve once, temp file beside the target, rename onto it.
  local target dir tmp; target=$(readlink -m -- "$ALSA_RC") || return 1
  dir=$(dirname -- "$target")
  mkdir -p -- "$dir" || return 1
  tmp=$(mktemp "$dir/.asoundrc.omaremote.XXXXXX") || return 1
  if ! printf '%s' "$1" > "$tmp"; then rm -f -- "$tmp"; return 1; fi
  if [[ -e $target ]]; then chmod --reference="$target" "$tmp" 2>/dev/null || true; else chmod 644 "$tmp"; fi
  mv -f -- "$tmp" "$target" || { rm -f -- "$tmp"; return 1; }
}

# alsa_rc_locked <fn> [args]: run fn holding the exclusive lock every repo writer of $ALSA_RC takes (spec §4.2), for
# the whole read-compare-generate-rename. Returns fn's status, or 1 when the directory cannot be made or the lock is
# not had within ALSA_LOCK_WAIT seconds. Editors outside the repo do not take it; spec §4.2 states what that leaves.
alsa_rc_locked() {
  local fd rc=0
  mkdir -p -- "$(dirname -- "$ALSA_RC")" 2>/dev/null || return 1
  exec {fd}>>"$ALSA_RC.omaremote.lock" || return 1
  if ! flock -w "$ALSA_LOCK_WAIT" "$fd"; then exec {fd}>&-; return 1; fi
  "$@" || rc=$?
  exec {fd}>&-
  return "$rc"
}

# atv_alsa_write: under the lock. Writes the atvvoice block if it changed; 2 = bad markers; sets ALSA_CHANGED.
atv_alsa_write() {
  ALSA_CHANGED=0
  alsa_rc_read || return 1
  local st; st=$(alsa_block_state "$ALSA_CONTENT" "$ALSA_BEGIN" "$ALSA_END" 0)
  [[ $st == bad ]] && return 2
  case $st in absent|present) ;; *) return 1 ;; esac
  local new; new=$(alsa_rc_put "$ALSA_CONTENT" "$ALSA_BEGIN" "$ALSA_END" "$(gen_alsa_block)" && printf x) || return 1
  new=${new%x}
  [[ $new == "$ALSA_CONTENT" ]] && return 0
  alsa_rc_write "$new" || return 1
  ALSA_CHANGED=1
}

alsa_mic_json() {   # alsa_mic_json absent | "present <node>": the one-line JSON alsa-mic prints
  if [[ $1 == absent ]]; then printf '{"state":"absent"}\n'; else printf '{"state":"present","node":"%s"}\n' "${1#present }"; fi
}
alsa_mic_usage() {
  printf 'usage: omaremote-setup alsa-mic get\n       omaremote-setup alsa-mic set (<node> | --absent) (--expect <node> | --expect-absent)\n' >&2
  exit 64
}
alsa_mic_node() { [[ $1 =~ $NODE_RE ]] || { printf 'omaremote-setup: not a PipeWire node name: %s\n' "$1" >&2; exit 64; }; }

# alsa_mic_set <target> <expected>: under the lock. States are "absent" or "present <node>".
# 2 = bad block, 3 = mismatch (current state printed), 1 = I/O; the file is unchanged on every non-zero return.
alsa_mic_set() {
  local st new blk=""
  alsa_rc_read || return 1
  st=$(alsa_block_state "$ALSA_CONTENT" "$MIC_BEGIN" "$MIC_END" 1)
  [[ $st == bad ]] && return 2
  [[ $st == absent || $st == "present "?* ]] || return 1
  if [[ $st != "$2" ]]; then alsa_mic_json "$st"; return 3; fi
  [[ $1 == absent ]] || blk=$(gen_mic_block "${1#present }")
  new=$(alsa_rc_put "$ALSA_CONTENT" "$MIC_BEGIN" "$MIC_END" "$blk" && printf x) || return 1
  new=${new%x}
  [[ $new == "$ALSA_CONTENT" ]] && return 0
  alsa_rc_write "$new"
}

cmd_alsa_mic() {   # mic source picker spec §4.2. No root, no prompt: the plugin calls this.
  case ${1:-} in
    get)
      (( $# == 1 )) || alsa_mic_usage
      alsa_rc_read || exit 1
      local st; st=$(alsa_block_state "$ALSA_CONTENT" "$MIC_BEGIN" "$MIC_END" 1)
      if [[ $st == bad ]]; then printf 'omaremote-setup: the omaremote mic block in %s is malformed\n' "$ALSA_RC" >&2; exit 2; fi
      [[ $st == absent || $st == "present "?* ]] || exit 1
      alsa_mic_json "$st"; exit 0 ;;
    set)
      shift
      local target="" expect="" rc=0
      while (( $# )); do
        case $1 in
          --absent) [[ -z $target ]] || alsa_mic_usage; target=absent; shift ;;
          --expect-absent) [[ -z $expect ]] || alsa_mic_usage; expect=absent; shift ;;
          --expect) [[ -z $expect && $# -ge 2 ]] || alsa_mic_usage; alsa_mic_node "$2"; expect="present $2"; shift 2 ;;
          -*) alsa_mic_usage ;;
          *) [[ -z $target ]] || alsa_mic_usage; alsa_mic_node "$1"; target="present $1"; shift ;;
        esac
      done
      [[ -n $target && -n $expect ]] || alsa_mic_usage
      alsa_rc_locked alsa_mic_set "$target" "$expect" || rc=$?
      exit "$rc" ;;
    *) alsa_mic_usage ;;
  esac
}

cmd_atvvoice() {
  step "ATVVoice (remote microphone)"
  command -v cargo >/dev/null 2>&1 \
    || die "cargo is missing. Run:  sudo pacman -S rustup && rustup default stable  -- then re-run this step."
  command -v git >/dev/null 2>&1 \
    || die "git is missing (ATVVoice is built from source). Run:  sudo pacman -S git  -- then re-run this step."
  [[ -f $ATV_PATCH ]] || die "the ATVVoice patch is missing: $ATV_PATCH"
  need bluetoothctl

  # Resolve the device before building or touching anything, so a missing remote changes nothing.
  local cands; mapfile -t cands < <(atv_candidates)
  (( ${#cands[@]} > 0 )) || die "no paired ATVV remote found (is Bluetooth on and the remote paired?)"
  (( ${#cands[@]} == 1 )) || die "several ATVV remotes are paired: ${cands[*]} -- unpair all but one"

  # Likewise the ALSA plugin the PCM below needs, so a missing package fails before a multi-minute build.
  local pwprobe=${OMAREMOTE_PW_ALSA_PROBE:-}
  if [[ -n $pwprobe ]]; then [[ -e $pwprobe ]]
  else [[ -e /usr/share/alsa/alsa.conf.d/50-pipewire.conf || -e /usr/lib/alsa-lib/libasound_module_pcm_pipewire.so ]]
  fi || die "the PipeWire ALSA plugin is missing (Voxtype can only open ALSA devices). Run:  sudo pacman -S --needed pipewire-alsa  -- then re-run this step."

  # And a user ALSA file we cannot edit safely (read-only check, one read), so it fails before anything is built or written.
  alsa_rc_read || die "cannot read $ALSA_RC"
  local pre_st; pre_st=$(alsa_block_state "$ALSA_CONTENT" "$ALSA_BEGIN" "$ALSA_END" 0)
  case $pre_st in
    absent|present) ;;
    bad) die "$ALSA_RC has unbalanced or misordered '$ALSA_BEGIN' / '$ALSA_END' markers; fix it by hand. Nothing was changed." ;;
    *) die "cannot read $ALSA_RC" ;;
  esac

  local built=0 want; want=$(atv_stamp_line)
  if [[ ! -x $ATV_BIN || $(cat "$ATV_STAMP" 2>/dev/null) != "$want" ]]; then
    say "building ATVVoice $ATV_REV + reset-decoder patch (a few minutes)"
    atv_build
    built=1
    say "built atvvoice ${ATV_REV:0:7} + reset-decoder patch"
  else
    say "atvvoice ${ATV_REV:0:7} + patch: up to date"
  fi

  gen_atv_unit "${cands[0]}" > "$WORKDIR/atvvoice.service"
  local changed=0
  if ! cmp -s "$WORKDIR/atvvoice.service" "$ATV_UNIT"; then
    mkdir -p "$(dirname "$ATV_UNIT")"
    cp "$WORKDIR/atvvoice.service" "$ATV_UNIT"
    systemctl --user daemon-reload
    changed=1
    say "wrote $ATV_UNIT (device ${cands[0]})"
  fi

  # The ALSA PCM: written after the build and the unit, so a failed build leaves this file alone too. Locked and
  # atomic, like every repo writer of this file (mic source picker spec §4.2).
  local alsa_rc=0
  alsa_rc_locked atv_alsa_write || alsa_rc=$?
  case $alsa_rc in
    0) ;;
    2) die "cannot generate $ALSA_RC (markers changed during the run?)" ;;
    *) die "cannot write $ALSA_RC" ;;
  esac
  local alsa_changed=$ALSA_CHANGED
  if (( alsa_changed )); then say "wrote $ALSA_RC (ALSA PCM $ATV_NODE)"; else say "ALSA PCM $ATV_NODE: unchanged"; fi
  # A running Voxtype read ALSA's config at start; make it re-read. Not fatal: a failure here must not stop
  # the atvvoice restart below, which is what repairs a running old build.
  if (( alsa_changed )) && systemctl --user is-active --quiet voxtype; then
    systemctl --user try-restart voxtype \
      || warn "could not restart voxtype to pick up the new ALSA PCM; run:  systemctl --user restart voxtype"
  fi

  # Three separate rules (spec §3): rewrite only on change; always ensure enabled+active, which repairs a
  # stopped or disabled service; restart a running service only when its unit or binary changed.
  local was_active=0
  systemctl --user is-active --quiet atvvoice && was_active=1
  systemctl --user enable --now atvvoice
  if (( was_active && (changed || built) )); then systemctl --user restart atvvoice; fi
  # The stamp is the "this build is live" record, so it is written last: a run that died after the install
  # (reload, ALSA write, enable, restart) rebuilds and restarts on the next run instead of leaving the old
  # unpatched process running with a stamp that says it is current.
  if (( built )); then
    mkdir -p "$(dirname "$ATV_STAMP")"
    printf '%s\n' "$want" > "$ATV_STAMP"
  fi
  say "ATVVoice: node $ATV_NODE, D-Bus org.atvvoice.$ATV_NAME"
}

# ---- Typeless engine: keytap daemon and hotkey (Plan 5; Typeless spec §4.3) ----------------------
KEYTAP_DIR=${OMAREMOTE_KEYTAP_DIR:-$HOME/.local/lib/omaremote}
KEYTAP_UNIT=${OMAREMOTE_KEYTAP_UNIT:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omaremote-keytap.service}
TYPELESS_SETTINGS=${OMAREMOTE_TYPELESS_SETTINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/Typeless/app-settings.json}
UINPUT=${OMAREMOTE_UINPUT:-/dev/uinput}
INPUT_SYSFS=${OMAREMOTE_INPUT_SYSFS:-/sys/class/input}
KEYTAP_SRC=$SELF_DIR/../host/omaremote-keytap   # like ATV_PATCH: resolves from host/ and from a test that sources this file
OMA_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/omaremote/config.json
SAVE_WAIT_MS=${OMAREMOTE_SAVE_WAIT_MS:-2000}
NO_SERVICE="the omaremote service is not running; start the shell, then re-run \`omaremote-setup typeless --hotkey …\`"

gen_keytap_unit() {   # gen_keytap_unit > file. %h keeps the unit independent of where the checkout lives.
  local exec='%h/.local/lib/omaremote/omaremote-keytap'
  [[ -n ${OMAREMOTE_KEYTAP_DIR:-} ]] && exec=$KEYTAP_DIR/omaremote-keytap   # tests only
  cat <<UNIT
[Unit]
Description=omaremote keytap (uinput hotkey taps for Typeless)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I $exec serve
Restart=on-failure

[Install]
WantedBy=graphical-session.target
UNIT
}

keytap_prereqs() {
  command -v python3 >/dev/null 2>&1 || die "python3 is missing. Run:  sudo pacman -S --needed python  -- then re-run this step."
  id -nG | tr ' ' '\n' | grep -qx input \
    || die "you are not in the input group (Typeless needs it too). Run:  sudo usermod -aG input \$USER  -- then log out and back in, and re-run this step."
  [[ -w $UINPUT ]] \
    || die "$UINPUT is not writable. Run:  sudo usermod -aG input \$USER  -- then log out and back in (a group change needs a new login)."
}

keytap_install() {
  [[ -f $KEYTAP_SRC ]] || die "the keytap script is missing: $KEYTAP_SRC"
  local changed=0
  mkdir -p "$KEYTAP_DIR"
  if ! cmp -s "$KEYTAP_SRC" "$KEYTAP_DIR/omaremote-keytap"; then
    install -m 0755 "$KEYTAP_SRC" "$KEYTAP_DIR/omaremote-keytap"; changed=1
    say "installed $KEYTAP_DIR/omaremote-keytap"
  fi
  gen_keytap_unit > "$WORKDIR/omaremote-keytap.service"
  if ! cmp -s "$WORKDIR/omaremote-keytap.service" "$KEYTAP_UNIT"; then
    mkdir -p "$(dirname "$KEYTAP_UNIT")"
    cp "$WORKDIR/omaremote-keytap.service" "$KEYTAP_UNIT"; changed=1
    say "wrote $KEYTAP_UNIT"
  fi
  systemctl --user daemon-reload
  systemctl --user enable --now omaremote-keytap
  if (( changed )); then systemctl --user restart omaremote-keytap; fi
  return 0
}

keytap_verify() {   # within 3 s: the input device exists and the daemon answers ping
  local i=0
  while (( i < 30 )); do
    if grep -qxs 'omaremote keytap' "$INPUT_SYSFS"/event*/device/name && python3 -I "$KEYTAP_DIR/omaremote-keytap" ping >/dev/null 2>&1; then
      say "keytap: input device present, daemon answers"
      return 0
    fi
    sleep 0.1; i=$((i + 1))
  done
  journalctl --user -u omaremote-keytap -n 20 --no-pager 2>/dev/null | sed 's/^/    /' >&2 || true
  die "omaremote-keytap did not come up within 3 s (its journal is above)"
}

typeless_value() {   # Typeless's dictationMode[0] when it is a string, else nothing
  jq -r '(.featureShortcutBindings.dictationMode // null) | if type == "array" then (.[0] // empty) else empty end | strings' \
    "$TYPELESS_SETTINGS" 2>/dev/null || true
}

hotkey_request() {   # hotkey_request <chord>: the IPC reply, or dies when there is no service
  local r; r=$(ipc typelessHotkey "$1" 2>/dev/null) && [[ -n $r ]] || die "$NO_SERVICE"
  printf '%s' "$r"
}

typeless_hotkey() {   # typeless_hotkey <explicit chord or ""> <from_typeless 0|1>
  local want=$1 from=$2 st stored adopted=0
  st=$(ipc status 2>/dev/null) && [[ -n $st ]] || die "$NO_SERVICE"
  stored=$(jq -r '.typeless.hotkeyStored | if type == "boolean" then tostring else empty end' <<<"$st" 2>/dev/null)   # not `// empty`: false is falsy
  [[ -n $stored ]] || die "$NO_SERVICE"
  if [[ -z $want ]] && { (( from )) || [[ $stored == false ]]; }; then
    want=$(typeless_value); adopted=1
    if [[ -z $want ]]; then
      want=RightAlt; adopted=0
      say "Typeless's dictation hotkey could not be read from $TYPELESS_SETTINGS; using RightAlt"
    else
      say "using Typeless's dictation hotkey: $want"
    fi
  fi
  if [[ -z $want ]]; then say "keeping the stored hotkey: $(jq -r '.typeless.hotkey' <<<"$st")"; return 0; fi

  local r; r=$(hotkey_request "$want")
  if [[ $(jq -r '.ok' <<<"$r") != true ]]; then
    local why; why=$(jq -r '.reason // "unknown"' <<<"$r")
    if (( adopted )) && [[ $why == "invalid chord: "* ]]; then        # an unusable Typeless value falls back, loudly
      say "Typeless's hotkey '$want' is not usable here ($why); using RightAlt"
      want=RightAlt; r=$(hotkey_request "$want")
      [[ $(jq -r '.ok' <<<"$r") == true ]] || die "the hotkey was not accepted: $(jq -r '.reason // "unknown"' <<<"$r")"
    else
      die "the hotkey was not accepted: $why"
    fi
  fi

  local canon seq; canon=$(jq -r '.hotkey' <<<"$r"); seq=$(jq -r '.writeSeq // empty' <<<"$r")
  if [[ -n $seq ]]; then
    local t0=${EPOCHREALTIME/./} state=""
    while :; do
      st=$(ipc status 2>/dev/null) && [[ -n $st ]] || die "$NO_SERVICE"
      state=$(jq -r --arg n "$seq" '.configWrites.saves[$n] // "unknown"' <<<"$st")
      case $state in
        saved) break ;;
        failed) die "saving config.json failed: $(jq -r --arg n "$seq" '.configWrites.errors[$n] // "unknown reason"' <<<"$st")" ;;
      esac
      (( (${EPOCHREALTIME/./} - t0) / 1000 >= SAVE_WAIT_MS )) && die "config.json write $seq was not confirmed within $((SAVE_WAIT_MS / 1000)) s (last state: $state)"
      sleep 0.1
    done
  fi
  local disk; disk=$(jq -r '.voice.typeless.hotkey // empty' "$OMA_CONFIG" 2>/dev/null)
  [[ $disk == "$canon" ]] || die "the hotkey was changed again before setup could confirm it (config.json holds '${disk:-nothing}', expected '$canon')"
  say "hotkey: $canon (saved)"
}

cmd_typeless() {   # cmd_typeless [--hotkey <chord> | --hotkey-from-typeless]
  need jq
  local want="" from=0
  while (( $# )); do
    case $1 in
      --hotkey) [[ $# -ge 2 && -n $2 ]] || die "usage: omaremote-setup typeless [--hotkey <chord> | --hotkey-from-typeless]"; want=$2; shift 2 ;;
      --hotkey-from-typeless) from=1; shift ;;
      *) die "unknown typeless option: $1 (usage: omaremote-setup typeless [--hotkey <chord> | --hotkey-from-typeless])" ;;
    esac
  done
  [[ -n $want && $from == 1 ]] && die "--hotkey and --hotkey-from-typeless are exclusive"
  step "Typeless engine: keytap daemon"
  keytap_prereqs
  keytap_install
  keytap_verify
  step "Typeless engine: hotkey"           # only after a working keytap: a failure here leaves the daemon running
  typeless_hotkey "$want" "$from"
  say "Switch the engine in the panel (Voice tab → Engine: Typeless). Setup never switches it."
}

cmd_all() {
  # keyd and the mic apply both stop for confirmation or restart a daemon, so a bare run is
  # interactive by design. Pass --yes to skip the keyd prompts. Plan 4: the remote's microphone is
  # the default; --mic system keeps the external-microphone flow and skips ATVVoice entirely.
  cmd_deps
  cmd_keyd
  cmd_binds
  cmd_plugin
  [[ $MIC_MODE == remote ]] && cmd_atvvoice
  cmd_mic "$MIC_MODE"
  cmd_verify
}

usage() {
  cat <<'USAGE'
usage: omaremote-setup [--yes] [--mic remote|system] <subcommand>

  deps     check host tools; report what to install (installs nothing itself)
  keyd     stage and validate /etc/keyd/omaremote.conf, then guide enabling the service
  binds    ensure the xkb option, generate ~/.config/hypr/omaremote.lua, reload and verify
  plugin   check the Omarchy plugin is installed and the service answers
  atvvoice build ATVVoice (pinned rev + host/patches/atvvoice-reset-decoder.patch; needs git and cargo),
           write its user unit for the paired remote, enable it, and
           define the ALSA PCM atvvoice-xiaomi that Voxtype opens (managed block in the ALSA file below)
  alsa-mic get | set (<node> | --absent) (--expect <node> | --expect-absent)
           read or compare-and-set the omaremote-mic PCM block (used by the plugin's mic picker; JSON out)
  mic      apply a mic mode (remote|system) through the mic-apply contract
  typeless install and start the omaremote-keytap user service (uinput; needs the input group) and store the
           Typeless dictation hotkey: typeless [--hotkey <chord> | --hotkey-from-typeless]. Never switches the
           engine; do that in the panel (Voice tab → Engine). Not part of the default flow.
  verify   verify the loaded binds and sweep the transport with the injector
  genconf  print the generated keyd config to stdout and exit (writes nothing)
  genlua   print the generated Hyprland binds to stdout and exit (writes nothing)

With no subcommand, every step runs in order (interactive: keyd confirms, mic restarts voxtype).
--mic remote (default) includes atvvoice and applies the remote mic; --mic system skips atvvoice
and applies the system/external mic.

Environment:
  OMAREMOTE_DEVICE   vendor:product of the remote (default 2717:32b8)
  OMAREMOTE_ALSA_RC  ALSA user config the atvvoice step edits (default ~/.config/alsa/asoundrc)
  OMAREMOTE_ATV_BIN    atvvoice binary whose presence the build check requires (default ~/.cargo/bin/atvvoice)
  OMAREMOTE_ATV_PATCH  patch applied to the pinned rev (default host/patches/atvvoice-reset-decoder.patch)
  OMAREMOTE_ATV_STAMP  build stamp the atvvoice step compares (default ~/.local/state/omaremote/atvvoice.build)
  OMAREMOTE_NODE_WAIT_MS  how long `mic remote` waits for the remote's audio node (default 30000)
  OMAREMOTE_NODE_POLL_MS  how often `mic remote` polls for that node (default 500)
  OMAREMOTE_KEYTAP_DIR, OMAREMOTE_KEYTAP_UNIT, OMAREMOTE_TYPELESS_SETTINGS, OMAREMOTE_UINPUT  test overrides for `typeless`
USAGE
}

main() {
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --yes) ASSUME_YES=1; shift ;;
      --mic) MIC_MODE=${2:-}; MIC_EXPLICIT=1; shift; [[ $# -gt 0 ]] && shift ;;   # never `shift 2 || true`: a bare --mic would loop forever
      --help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ $MIC_MODE == remote || $MIC_MODE == system ]] || die "usage: --mic remote|system (got: ${MIC_MODE:-nothing})"
  case ${1:-} in
    deps) cmd_deps ;;
    keyd) cmd_keyd ;;
    binds) cmd_binds ;;
    plugin) cmd_plugin ;;
    atvvoice) cmd_atvvoice ;;
    alsa-mic) shift; cmd_alsa_mic "$@" ;;
    mic) if (( MIC_EXPLICIT )); then cmd_mic "${2:-$MIC_MODE}"; else cmd_mic "${2:-system}"; fi ;;
    typeless) shift; cmd_typeless "$@" ;;
    verify) cmd_verify ;;
    genconf) cmd_genconf ;;
    genlua) gen_lua ;;
    "") cmd_all ;;
    help) usage ;;
    *) die "unknown subcommand: $1" ;;
  esac
}

main "$@"
